# VBML 1.0.3
#--------------------------------------------------------------------------------------------------
# Properties
#--------------------------------------------------------------------------------------------------

type: backend

source: https://raw.githubusercontent.com/omega-gg/backend/master/tiktok.vbml

api: 1.0.3

version: 1.0.11

title: TikTok

host: tiktok.com

cover: /cover/tiktok.png

items:
    playlist:
        title: Tracks

validate: ^tiktok.com

#--------------------------------------------------------------------------------------------------
# Routines
#--------------------------------------------------------------------------------------------------

TRACK_ID: |
    SET url (URL_REMOVE_PREFIX (URL_REMOVE_EXTENSION url))
    IF (EQUAL (CONTAIN url "/video/") false)
        RETURN ""
    FI
    RETURN (MID url (INDEX_END url '/'))

URL_TRACK: |
    RETURN (APPEND "https://www.tiktok.com/" id)

URL_PLAYLIST: |
    RETURN (APPEND "https://www.tiktok.com/" id)

PLAYLIST_INFO: |
    SET url (URL_REMOVE_PREFIX (URL_REMOVE_EXTENSION url))
    IF (EQUAL (CONTAIN url "/@") false)
    OR (NOT_EQUAL (COUNT_STRING url '/') 1)
        RETURN false
    FI
    SET type "feed"
    SET id (MID url (INDEX_END url '/'))
    RETURN true

QUERY_SOURCE: |
    SET url (URL_REMOVE_PREFIX (URL_REMOVE_EXTENSION url))
    IF (EQUAL (CONTAIN url "/video/") false)
        RETURN false
    FI
    SET url (APPEND "https://www." url)
    # NOTE: A stream is refused without the cookies of its page.
    SET cookies true
    RETURN true

QUERY_TRACK: |
    SET url (URL_REMOVE_PREFIX (URL_REMOVE_EXTENSION url))
    IF (EQUAL (CONTAIN url "/video/") false)
        RETURN false
    FI
    SET url (APPEND "https://www." url)
    RETURN true

QUERY_PLAYLIST: |
    SET url (URL_REMOVE_PREFIX (URL_REMOVE_EXTENSION url))
    IF (EQUAL (CONTAIN url "/@") false)
    OR (NOT_EQUAL (COUNT_STRING url '/') 1)
        RETURN false
    FI
    SET url (APPEND "https://www.tiktok.com/" (MID url (INDEX_END url '/')))
    RETURN true

EXTRACT_SOURCE: |
    SET data (READ data "utf-8")
    SET index (INDEX_END data "\"itemStruct\"")
    SET source (JSON_EXTRACT_UTF8 data "playAddr" index)
    IF (EQUAL source "")
        RETURN
    FI
    HASH_SET medias (JSON_EXTRACT data "height" index) source
    SET options (LIST (APPEND "header=Cookie: " cookie) (APPEND "header=Referer: " url))
    SET expiry (ADD (DATE) 1800) # Half an hour

EXTRACT_TRACK: |
    SET data (READ data "utf-8")
    SET index (INDEX_END data "\"itemStruct\"")
    SET title (JSON_EXTRACT_UTF8 data "desc" index)
    SET cover (JSON_EXTRACT_UTF8 data "cover" index)
    SET author (JSON_EXTRACT_UTF8 data "nickname" index)
    SET feed (APPEND "https://www.tiktok.com/@" (JSON_EXTRACT data "uniqueId" index))
    SET duration (MULTIPLY (JSON_EXTRACT data "duration" index) 1000)
    SET date (JSON_EXTRACT data "createTime" index)

EXTRACT_PLAYLIST: |
    SET data (READ data "utf-8")
    IF (EQUAL id 0) # Channel
        SET index (INDEX_END data "\"webapp.user-detail\"")
        SET title (JSON_EXTRACT_UTF8 data "nickname" index)
        SET cover (JSON_EXTRACT_UTF8 data "avatarLarger" index)
        SET string (JSON_EXTRACT data "secUid" index)
        HASH_SET next "url" (APPEND "https://www.tiktok.com/api/creator/item_list/" \
                                    "?aid=1988&count=15&cursor=0&type=1&secUid=" string)
        HASH_SET next "id" 1
        RETURN
    FI
    SET list (JSON_SPLIT (JSON_EXTRACT data "itemList"))
    FOREACH list value
        # NOTE: A post made of images has no video to play.
        IF (CONTAIN value "\"imagePost\"")
            CONTINUE
        FI
        SET string (JSON_EXTRACT value "uniqueId")
        # NOTE: The first id of a track is the one of its author.
        SET id (JSON_EXTRACT value "id" (INDEX_END value "\"desc\""))
        SET index (INDEX_END value "\"video\"")
        HASH_SET track "source" (APPEND "https://www.tiktok.com/@" string "/video/" id)
        HASH_SET track "title" (JSON_EXTRACT_UTF8 value "desc")
        HASH_SET track "cover" (JSON_EXTRACT_UTF8 value "cover" index)
        HASH_SET track "author" (JSON_EXTRACT_UTF8 value "nickname")
        HASH_SET track "feed" (APPEND "https://www.tiktok.com/@" string)
        HASH_SET track "duration" (MULTIPLY (JSON_EXTRACT value "duration" index) 1000)
        LIST_APPEND tracks track
    END
